{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The editor window: its own commands and the event bus, nothing else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "core:window:allow-set-title",
    "allow-app-init",
    "allow-open-workspace-dialog",
    "allow-open-recent-workspace",
    "allow-close-workspace",
    "allow-workspace-project",
    "allow-open-file-dialog",
    "allow-save-file-dialog",
    "allow-open-trace-dialog",
    "allow-pick-rewind-dialog",
    "allow-save-settings",
    "allow-save-session",
    "allow-toolchain-info",
    "allow-app-exit",
    "allow-list-dir",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-file-stamp",
    "allow-create-file",
    "allow-create-dir",
    "allow-rename-path",
    "allow-delete-path",
    "allow-reveal-path",
    "allow-lsp-start",
    "allow-lsp-request",
    "allow-lsp-notify",
    "allow-lsp-stop",
    "allow-dap-start",
    "allow-dap-request",
    "allow-dap-stop",
    "allow-task-start",
    "allow-task-input",
    "allow-task-close-input",
    "allow-task-kill",
    "allow-list-workspace-files",
    "allow-search-start",
    "allow-search-cancel",
    "allow-search-replace",
    "allow-load-timeline"
  ]
}